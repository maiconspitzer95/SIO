NODE_ENV=development
# 0.0.0.0 = aceita acesso pela rede (ex.: http://192.168.2.214:5004)
HOST=0.0.0.0
PORT=5004
# Endereços oficiais separados por vírgula. Os IPs da máquina e localhost
# na mesma porta são liberados automaticamente.
APP_ORIGIN=http://192.168.2.214:5004,http://localhost:5004
# Opcional: nomes DNS internos extras (ex.: sio.santacasa.local)
ALLOWED_HOSTS=
DATABASE_URL=postgresql://SIC:PREENCHA_A_SENHA@localhost:5432/sic
# Gere: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=REPLACE_WITH_AT_LEAST_48_RANDOM_CHARACTERS
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8
TRUST_PROXY=0
PG_SSL=false
PG_CA_FILE=
# Opcional: armazenamento privado fora da pasta sincronizada
STORAGE_PATH=
# Somente para provisionamento inicial. Remova a senha após usar.
ADMIN_LOGIN=
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
RESET_LOGIN=
