NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://sio_user:CHANGE_ME@localhost:5432/sio
# Gere: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=REPLACE_WITH_AT_LEAST_48_RANDOM_CHARACTERS
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8
# Produção: HTTPS obrigatório; 1 somente atrás de proxy local confiável.
TRUST_PROXY=0
PG_SSL=false
# Opcional: caminho do certificado CA para PostgreSQL remoto
PG_CA_FILE=
# Usadas somente pelo comando admin:create. Remova após provisionar.
ADMIN_LOGIN=
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Recuperação administrativa: password:issue exige RESET_LOGIN.
RESET_LOGIN=
